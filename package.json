{
	"name": "@ainekio/engine",
	"version": "0.1.0",
	"description": "Framework-neutral TypeScript ECS 3D game and simulation engine with Three.js, Rapier, PeerJS, and browser adapters.",
	"license": "MIT",
	"type": "module",
	"sideEffects": false,
	"packageManager": "pnpm@9.14.4",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./math": {
			"types": "./dist/math/index.d.ts",
			"import": "./dist/math/index.js"
		},
		"./data": {
			"types": "./dist/data/index.d.ts",
			"import": "./dist/data/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime/index.d.ts",
			"import": "./dist/runtime/index.js"
		},
		"./client-api": {
			"types": "./dist/client-api/index.d.ts",
			"import": "./dist/client-api/index.js"
		},
		"./modules": {
			"types": "./dist/modules/index.d.ts",
			"import": "./dist/modules/index.js"
		},
		"./modules/assets": {
			"types": "./dist/modules/assets/index.d.ts",
			"import": "./dist/modules/assets/index.js"
		},
		"./modules/audio": {
			"types": "./dist/modules/audio/index.d.ts",
			"import": "./dist/modules/audio/index.js"
		},
		"./modules/camera": {
			"types": "./dist/modules/camera/index.d.ts",
			"import": "./dist/modules/camera/index.js"
		},
		"./modules/debug": {
			"types": "./dist/modules/debug/index.d.ts",
			"import": "./dist/modules/debug/index.js"
		},
		"./modules/input": {
			"types": "./dist/modules/input/index.d.ts",
			"import": "./dist/modules/input/index.js"
		},
		"./modules/networking": {
			"types": "./dist/modules/networking/index.d.ts",
			"import": "./dist/modules/networking/index.js"
		},
		"./modules/physics": {
			"types": "./dist/modules/physics/index.d.ts",
			"import": "./dist/modules/physics/index.js"
		},
		"./modules/rendering": {
			"types": "./dist/modules/rendering/index.d.ts",
			"import": "./dist/modules/rendering/index.js"
		},
		"./modules/scene": {
			"types": "./dist/modules/scene/index.d.ts",
			"import": "./dist/modules/scene/index.js"
		},
		"./multiplayer": {
			"types": "./dist/multiplayer/index.d.ts",
			"import": "./dist/multiplayer/index.js"
		},
		"./adapters/browser": {
			"types": "./dist/adapters/browser/index.d.ts",
			"import": "./dist/adapters/browser/index.js"
		},
		"./adapters/browser/networking/peer-transport": {
			"types": "./dist/adapters/browser/networking/peerTransport.d.ts",
			"import": "./dist/adapters/browser/networking/peerTransport.js"
		},
		"./adapters/browser/networking/room-directory": {
			"types": "./dist/adapters/browser/networking/roomDirectory.d.ts",
			"import": "./dist/adapters/browser/networking/roomDirectory.js"
		},
		"./adapters/rapier": {
			"types": "./dist/adapters/rapier/index.d.ts",
			"import": "./dist/adapters/rapier/index.js"
		},
		"./adapters/three": {
			"types": "./dist/adapters/three/index.d.ts",
			"import": "./dist/adapters/three/index.js"
		}
	},
	"scripts": {
		"prepare": "tsc -p tsconfig.build.json",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
		"build": "pnpm clean && tsc -p tsconfig.build.json",
		"type-check": "tsc -p tsconfig.json --noEmit",
		"audit:boundaries": "node ./scripts/audit-engine-boundaries.mjs",
		"test": "tsx ./tests/engine-contracts.test.ts",
		"lint": "biome check ./src ./scripts ./tests",
		"format": "biome format --write ./src ./scripts ./tests",
		"check": "pnpm audit:boundaries && pnpm lint && pnpm type-check && pnpm build && pnpm test"
	},
	"peerDependencies": {
		"@dimforge/rapier3d-compat": ">=0.17.0",
		"peerjs": ">=1.5.0",
		"three": ">=0.175.0"
	},
	"peerDependenciesMeta": {
		"@dimforge/rapier3d-compat": {
			"optional": true
		},
		"peerjs": {
			"optional": true
		},
		"three": {
			"optional": true
		}
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@dimforge/rapier3d-compat": "0.17.3",
		"@types/node": "25.3.0",
		"@types/three": "0.176.0",
		"peerjs": "^1.5.5",
		"three": "0.178.0",
		"tsx": "4.21.0",
		"typescript": "^5.7.3"
	}
}
